{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticAction",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "investigation_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "APPROVED",
        "DENIED",
        "EXECUTING",
        "COMPLETED",
        "FAILED"
      ]
    },
    "tool_name": {
      "type": "string"
    },
    "arguments": {
      "type": "object"
    },
    "reason": {
      "type": "string"
    },
    "target_hypothesis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "expected_discrimination": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "estimated_cost": {
      "type": "number",
      "minimum": 0
    },
    "actual_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "policy_decision_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "investigation_id",
    "status",
    "tool_name",
    "arguments",
    "reason",
    "target_hypothesis_ids",
    "expected_discrimination",
    "estimated_cost"
  ],
  "additionalProperties": false
}
