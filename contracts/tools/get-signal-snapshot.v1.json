{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetSignalSnapshotRequest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "investigation_id": {
      "type": "string",
      "format": "uuid"
    },
    "signal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample_index": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "investigation_id",
    "signal_ids",
    "sample_index"
  ],
  "additionalProperties": false
}
